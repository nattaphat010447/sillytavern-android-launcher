# Copy this file to keystore.properties and fill in your values.
# keystore.properties is gitignored — NEVER commit it.
#
# Alternatively, set these as environment variables for CI:
#   RELEASE_KEYSTORE_PATH
#   RELEASE_KEYSTORE_PASSWORD
#   RELEASE_KEY_ALIAS
#   RELEASE_KEY_PASSWORD

storeFile=C:/Users/User/.android-keystores/standroid-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=standroid
keyPassword=YOUR_KEY_PASSWORD
