<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — wraps ic_launcher with a 22% inset on all sides
    so the art stays within the safe zone (inner ~66dp of the 108dp canvas).
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher"
    android:inset="22%" />
